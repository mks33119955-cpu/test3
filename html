<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0b2048">
<title>Экспресс-доставка сборных грузов по России — ТК Грузовая Компания</title>
<meta name="description" content="Экспресс-доставка сборных грузов по России для федеральных компаний. Москва — Новосибирск за 3 дня.">

<style>
:root{
  --navy:#0b2048;
  --blue:#163b82;
  --sky:#55c7f5;
  --sky-dark:#168ac7;
  --white:#fff;
  --muted:#5a6b88;
  --pale:#f3f7fc;
  --line:#e3eaf4;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  color:var(--navy);
  background:var(--white);
  line-height:1.6;
  font-size:16px;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none;transition:color .2s}
a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{
  outline:3px solid var(--sky-dark);outline-offset:2px;border-radius:4px;
}
.wrap{width:min(1160px,calc(100% - 40px));margin:0 auto}

/* Header */
.top{
  display:flex;align-items:center;justify-content:space-between;
  gap:20px;padding:18px 0;position:relative;z-index:100;
}
.logo{width:180px;height:auto;max-width:50%}
.nav{display:flex;gap:22px;align-items:center;font-size:14px;font-weight:600}
.nav a:hover{color:var(--sky-dark)}
.head-actions{display:flex;align-items:center;gap:16px}
.head-phone{display:flex;flex-direction:column;line-height:1.2}
.head-phone strong{font-weight:800;font-size:15px}
.head-phone span{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.08em}

/* Burger */
.burger{
  display:none;background:none;border:0;width:44px;height:44px;
  cursor:pointer;padding:0;position:relative;z-index:1001;
}
.burger span{
  display:block;width:26px;height:3px;background:var(--navy);
  margin:5px auto;border-radius:2px;transition:.25s;
}
.burger.active span:nth-child(1){transform:translateY(8px) rotate(45deg)}
.burger.active span:nth-child(2){opacity:0}
.burger.active span:nth-child(3){transform:translateY(-8px) rotate(-45deg)}

/* Buttons */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  min-height:50px;padding:13px 24px;border-radius:10px;
  background:var(--sky);color:var(--navy);font-weight:800;font-size:15px;
  border:0;cursor:pointer;font-family:inherit;
  transition:transform .2s,box-shadow .2s,background .2s;
}
.btn:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(0,29,73,.18);background:#82d8fb}
.btn.dark{background:var(--navy);color:#fff}
.btn.dark:hover{background:#12326b}
.btn.ghost{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.4)}
.btn.ghost:hover{background:rgba(255,255,255,.12);border-color:#fff}

/* Hero */
.hero{
  background:linear-gradient(105deg,rgba(11,32,72,.94),rgba(11,32,72,.78)),var(--navy);
  min-height:600px;display:grid;place-items:center;text-align:center;color:#fff;
  padding:80px 0;
}
.hero.has-image{background-image:linear-gradient(105deg,rgba(11,32,72,.94),rgba(11,32,72,.78)),url('img/hero.jpg');background-size:cover;background-position:center}
.eyebrow{text-transform:uppercase;letter-spacing:.17em;font-size:12px;font-weight:800;color:var(--sky);margin:0}
h1{font-size:clamp(36px,5.5vw,72px);line-height:1.08;letter-spacing:-.05em;margin:20px auto;max-width:1000px;font-weight:900}
h2{font-size:clamp(28px,3.8vw,44px);letter-spacing:-.04em;line-height:1.15;margin:12px 0 18px;font-weight:800}
h3{font-size:19px;line-height:1.3;margin:12px 0;font-weight:700}
.hero p{max-width:680px;margin:0 auto 30px;color:#e4efff;font-size:clamp(16px,1.8vw,19px)}
.hero .accent{color:var(--sky)}
.hero-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.hero-trust{margin-top:40px;display:flex;gap:32px;justify-content:center;flex-wrap:wrap;color:#c7d8f2;font-size:13px}
.hero-trust b{color:#fff;display:block;font-size:24px;letter-spacing:-.03em;font-weight:800}
.hero-trust div{text-align:center}

section{padding:90px 0}
.intro{max-width:700px;color:var(--muted);font-size:17px}

.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:36px}

.problem{
  border:1px solid var(--line);border-radius:18px;padding:30px;background:#fff;
  transition:transform .25s,box-shadow .25s;
}
.problem:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(11,32,72,.08)}
.problem svg{width:36px;height:36px;stroke:#2589ca;stroke-width:1.7;fill:none;stroke-linecap:round;stroke-linejoin:round}
.problem p,.solution p{color:var(--muted);margin:0}

.soft{background:var(--pale)}
.solution{
  display:grid;grid-template-columns:1.15fr 1fr;gap:40px;align-items:center;
  background:#fff;border-radius:24px;padding:40px;box-shadow:0 20px 60px rgba(11,32,72,.1);
}
.solution-img{
  width:100%;border-radius:16px;min-height:320px;object-fit:cover;
  background:linear-gradient(135deg,#163b82,#55c7f5);
}
.ticks{padding:0;list-style:none;display:grid;gap:12px;margin-top:24px}
.ticks li{position:relative;padding-left:30px}
.ticks li::before{
  content:'✓';position:absolute;left:0;top:0;width:20px;height:20px;
  background:var(--sky);color:var(--navy);border-radius:50%;
  display:grid;place-items:center;font-size:12px;font-weight:900;
}

.routes{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:36px}
.route{
  border:1px solid var(--line);border-radius:16px;padding:26px;background:#fff;
  transition:transform .25s,box-shadow .25s;display:flex;flex-direction:column;
}
.route:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(11,32,72,.08)}
.route .cities{font-weight:700;line-height:1.4;min-height:54px}
.route strong{display:block;font-size:42px;letter-spacing:-.05em;color:#1668ad;margin-top:14px;line-height:1}
.route small{color:var(--muted);margin-top:6px}
.route-cta{margin-top:16px;font-size:13px;font-weight:700;color:var(--sky-dark)}
.note{color:var(--muted);font-size:12px;margin-top:22px}

.industries{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
.industries span{
  background:#fff;border:1px solid var(--line);padding:11px 16px;
  border-radius:100px;font-weight:600;font-size:13px;
}

.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:40px;counter-reset:step}
.step{background:#fff;border:1px solid var(--line);border-radius:16px;padding:26px 22px}
.step::before{
  counter-increment:step;content:counter(step,decimal-leading-zero);
  font-size:13px;font-weight:800;color:var(--sky-dark);
  letter-spacing:.15em;display:block;margin-bottom:12px;
}
.step h3{margin:0 0 6px;font-size:17px}
.step p{color:var(--muted);font-size:14px;margin:0}

.offer{
  background:var(--navy);color:#fff;border-radius:24px;padding:50px;
  display:grid;grid-template-columns:1.5fr 1fr;gap:40px;align-items:center;
}
.offer p{color:#d6e5fb}
.offer .eyebrow{color:var(--sky)}
.offer .btn{width:100%}
.offer small{display:block;color:#c2d4ed;margin-top:12px;text-align:center;font-size:12px}

.form-card{
  background:#fff;border-radius:24px;padding:40px;box-shadow:0 20px 60px rgba(11,32,72,.1);
  display:grid;grid-template-columns:1fr 1.2fr;gap:40px;align-items:start;
}
.form-card h3{font-size:22px;margin-top:0}
.form-card p{color:var(--muted);margin-top:0}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.field{display:flex;flex-direction:column;gap:5px}
.field.full{grid-column:1 / -1}
.field label{font-size:13px;font-weight:600}
.field input,.field textarea{
  font-family:inherit;font-size:15px;color:var(--navy);
  padding:12px 14px;border:1.5px solid var(--line);border-radius:10px;
  background:#fbfdff;width:100%;transition:border-color .2s;
}
.field input:focus,.field textarea:focus{outline:none;border-color:var(--sky)}
.field textarea{resize:vertical;min-height:80px}
.checkbox{display:flex;gap:10px;align-items:flex-start;font-size:12px;color:var(--muted);grid-column:1 / -1}
.checkbox input{width:18px;height:18px;margin-top:2px;flex:0 0 auto}
.form-card .btn{width:100%;margin-top:4px}

.faq{max-width:820px;margin:36px auto 0}
.faq details{
  border:1px solid var(--line);border-radius:14px;margin-bottom:10px;
  background:#fff;overflow:hidden;
}
.faq summary{
  cursor:pointer;padding:18px 22px;font-weight:700;font-size:16px;
  list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;
}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:'+';font-size:22px;color:var(--sky-dark);font-weight:400;transition:transform .2s}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq .answer{padding:0 22px 20px;color:var(--muted);font-size:15px}

.footer{border-top:1px solid var(--line);padding:40px 0 28px;background:#fff}
.foot{display:flex;align-items:flex-start;justify-content:space-between;gap:26px;flex-wrap:wrap}
.contact{display:grid;gap:6px;font-size:14px}
.contact a:hover{color:var(--sky-dark)}
.contact strong{font-size:15px}
.qr{
  width:110px;height:110px;border-radius:12px;background:var(--pale);
  display:grid;place-items:center;padding:8px;
}
.copy{
  font-size:12px;color:var(--muted);margin-top:24px;padding-top:20px;
  border-top:1px solid var(--line);display:flex;justify-content:space-between;
  gap:16px;flex-wrap:wrap;
}

@media (max-width:1000px){
  .routes{grid-template-columns:repeat(2,1fr)}
  .steps{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:800px){
  .nav{
    position:fixed;top:0;right:0;bottom:0;width:min(320px,85vw);
    background:#fff;flex-direction:column;align-items:flex-start;
    padding:100px 30px 30px;gap:20px;font-size:17px;
    transform:translateX(100%);transition:transform .3s;
    box-shadow:-20px 0 60px rgba(11,32,72,.18);z-index:1000;overflow-y:auto;
  }
  .nav.open{transform:none}
  .burger{display:block}
  .head-phone{display:none}
  .head-actions .btn{display:none}
  .hero{min-height:540px;padding:70px 0}
  .grid,.solution,.offer,.form-card{grid-template-columns:1fr}
  .solution{padding:22px;gap:22px}
  .offer{padding:28px;gap:18px}
  .form-card{padding:24px;gap:22px}
  section{padding:60px 0}
  .hero-trust{gap:20px}
  .hero-trust b{font-size:20px}
  .steps{grid-template-columns:1fr}
}
@media (max-width:520px){
  .wrap{width:min(100% - 28px,1160px)}
  .routes{grid-template-columns:1fr}
  .route .cities{min-height:0}
  .hero{min-height:520px}
  .problem{padding:22px}
  .logo{width:150px}
  .form-grid{grid-template-columns:1fr}
  .hero-cta .btn{width:100%}
}
</style>
</head>
