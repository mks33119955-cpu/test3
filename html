  <div class="head-actions">
    <a class="head-phone" href="tel:+79231148650">
      <strong>+7 923 114-86-50</strong>
      <span>Пн–Пт, 9:00–19:00</span>
    </a>
    <a class="btn dark" href="#offer">Запросить расчёт</a>
