<a href="#main" style="position:absolute;left:-9999px">К содержимому</a>

<header class="wrap top">
  <a href="/" aria-label="На главную">
    <img class="logo" src="img/logo.png" alt="ТК Грузовая Компания"
         onerror="this.style.display='none';this.parentNode.insertAdjacentHTML('beforeend','<div style=&quot;font-weight:900;font-size:18px;letter-spacing:-.03em&quot;>ТК ГРУЗОВАЯ</div>')">
  </a>

  <nav class="nav" id="nav" aria-label="Основная навигация">
    <a href="#problems">Задачи</a>
